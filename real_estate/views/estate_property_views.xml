<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="real_estate_estate_property_view_tree" model="ir.ui.view">
        <field name="name">estate.property.tree</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <tree string="Properties">
                <field name="name"/>
                <field name="property_type_id"/>
                <field name="postcode"/>
                <field name="bedrooms"/>
                <field name="living_area"/>
                <field name="expected_price"/>
                <field name="selling_price"/>
                <field name="availability_date"/>
            </tree>
        </field>
    </record>

    <record id="real_estate_estate_property_view_search" model="ir.ui.view">
        <field name="name">estate.property.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search string="Estate Property">
                <field name="name"/>
                <field name="postcode"/>
                <field name="expected_price"/>
                <field name="bedrooms"/>
                <field name="living_area"/>
                <field name="facades"/>
                <filter string="Available" name="available" domain="['|', ('state', '=', 'new'), ('state', '=', 'offer_received')]"/>
                <filter string="Postcode" name="postcode" context="{'group_by':'postcode'}"/>
                <filter string="Property Type" name="property_type" context="{'group_by':'property_type_id'}"/>
            </search>
        </field>
    </record>

    <record id="real_estate_estate_property_view_form" model="ir.ui.view">
        <field name="name">estate.property.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="Estate Property">
                <sheet>
                    <div class="oe_title ml16">
                        <h1 class="mb16">
                            <field name="name" class="mb16"/>
                        </h1>
                    </div>
                    <group class="mb16 ml16">
                        <group>
                            <field name="property_type_id" class="ml16"/>
                            <field name="postcode" class="ml16"/>
                            <field name="availability_date" class="ml16"/>
                        </group>
                        <group>
                            <field name="expected_price" class="ml16"/>
                            <field name="selling_price" class="ml16"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" class="ml16">
                            <group class="ml16">
                                <field name="description" class="ml16"/>
                                <field name="bedrooms" class="ml16"/>
                                <field name="living_area" class="ml16"/>
                                <field name="facades" class="ml16"/>
                                <field name="garage" class="ml16"/>
                                <field name="garden" class="ml16"/>
                                <field name="garden_area" class="ml16"/>
                                <field name="garden_orientation" class="ml16"/>
                                <field name="active" class="ml16"/>
                            </group>
                        </page>
                        <page string="Other Info">
                            <group class="ml16 col-4">
                                <field name="user_id" class="ml16"/>
                                <field name="client_id" class="ml16"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="real_estate_estate_property_action" model="ir.actions.act_window">
        <field name="name">Estate Properties</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>