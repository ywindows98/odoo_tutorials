<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="real_estate_estate_property_view_kanban" model="ir.ui.view">
        <field name="name">estate.property.kanban</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <kanban default_group_by="property_type_id">
                <field name="state"/>
                <field name="property_type_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div>
                                <field name="name" class="fw-bold"/>
                            </div>
                            <div>
                                Expected Price:
                                <field name="expected_price"/>
                            </div>
                            <div t-if="record.state.raw_value != 'new'">
                                Best Offer:
                                <field name="best_price"/>
                            </div>
                            <div t-if="record.state.raw_value == 'offer_accepted' or record.state.raw_value == 'sold'">
                                Selling Price:
                                <field name="selling_price"/>
                            </div>
                            <div>
                                <field name="tag_ids" widget="many2many_tags" class="mb16" string="Tags:" options="{'color_field': 'color'}"/>
                            </div>
                            <div t-if="record.state.raw_value == 'new'">
                                This is new!
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="real_estate_estate_property_view_tree" model="ir.ui.view">
        <field name="name">estate.property.tree</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <tree string="Properties"
                  decoration-bf="state in ['offer_accepted']"
                  decoration-success="state in ['offer_received', 'offer_accepted']"
                  decoration-danger="state in ['canceled']"
                  decoration-muted="state in ['sold']">
                <field name="name"/>
                <field name="property_type_id"/>
                <field name="postcode"/>
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                <field name="bedrooms"/>
                <field name="living_area"/>
                <field name="expected_price"/>
                <field name="selling_price"/>
                <field name="availability_date" optional="True"/>
                <field name="state" optional="True"/>
            </tree>
        </field>
    </record>

    <record id="real_estate_estate_property_view_search" model="ir.ui.view">
        <field name="name">estate.property.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search string="Estate Property">
                <field name="name"/>
                <field name="postcode"/>
                <field name="expected_price"/>
                <field name="bedrooms"/>
                <field name="living_area" filter_domain="[('living_area', '>=', self)]"/>
                <field name="facades"/>
                <filter string="Available" name="available" domain="['|', ('state', '=', 'new'), ('state', '=', 'offer_received')]"/>
                <filter string="Postcode" name="postcode" context="{'group_by':'postcode'}"/>
                <filter string="Property Type" name="property_type" context="{'group_by':'property_type_id'}"/>
            </search>
        </field>
    </record>

    <record id="real_estate_estate_property_view_form" model="ir.ui.view">
        <field name="name">estate.property.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="Estate Property">
                <header class="">
                        <button name="sell_estate_property_action" type="object" string="Sold" class="ml32" invisible="state == 'sold' or state == 'canceled'"/>
                        <button name="cancel_estate_property_action" type="object" string="Cancel" invisible="state == 'sold' or state == 'canceled'"/>
                        <field name="state" widget="statusbar" statusbar_visible="new, offer_received, offer_accepted, sold" class="mr32"/>
                </header>
                <sheet class="">
                    <div class="oe_title ml16 mb8 mt24">
                        <h1 class="mb12" >
                            <field name="name"/>
                        </h1>
                        <field name="tag_ids" widget="many2many_tags" class="mb16" string="Tags:" options="{'color_field': 'color'}"/>
                    </div>
                    <group class="mb16 ml16">
                        <group>
                            <field name="property_type_id" options="{'no_create': true, 'no_open': true}"/>
                            <field name="postcode"/>
                            <field name="availability_date"/>
                        </group>
                        <group>
                            <field name="expected_price"/>
                            <field name="best_price"/>
                            <field name="selling_price"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" class="ml16">
                            <group class="ml16">
                                <field name="description"/>
                                <field name="bedrooms"/>
                                <field name="living_area"/>
                                <field name="facades"/>
                                <field name="garage"/>
                                <field name="garden"/>
                                <field name="garden_area" invisible="not garden"/>
                                <field name="garden_orientation" invisible="not garden"/>
                                <field name="total_area"/>
                                <field name="active"/>
                            </group>
                        </page>
                        <page string="Offers">
                            <group class="ml16">
                                <field name="offer_ids" string="Offers" readonly="state in ['sold', 'canceled', 'offer_accepted']"/>
                            </group>
                        </page>
                        <page string="Other Info">
                            <group class="ml16 col-4">
                                <field name="user_id"/>
                                <field name="partner_id"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="real_estate_estate_property_action" model="ir.actions.act_window">
        <field name="name">Estate Properties</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">tree,form,kanban</field>
        <field name="context">
            {
                'search_default_available': 1
            }
        </field>
    </record>
</odoo>