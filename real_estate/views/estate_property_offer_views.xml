<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="real_estate_estate_property_offer_view_tree" model="ir.ui.view">
        <field name="name">estate.property.offer.tree</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <tree string="Properties">
                <field name="price"/>
                <field name="partner_id"/>
                <field name="status"/>
            </tree>
        </field>
    </record>

    <record id="real_estate_estate_property_offer_view_form" model="ir.ui.view">
        <field name="name">estate.property.offer.form</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <form string="Estate Property">
                <sheet>
                    <group class="mb16 ml16">
                        <group>
                            <field name="partner_id" class="ml16"/>
                            <field name="price" class="ml16"/>
                            <field name="status" class="ml16"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>