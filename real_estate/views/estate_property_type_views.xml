<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="real_estate_estate_property_type_view_tree" model="ir.ui.view">
        <field name="name">estate.property.type.tree</field>
        <field name="model">estate.property.type</field>
        <field name="arch" type="xml">
            <tree string="Property Types">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="real_estate_estate_property_type_view_search" model="ir.ui.view">
        <field name="name">estate.property.type.search</field>
        <field name="model">estate.property.type</field>
        <field name="arch" type="xml">
            <search string="Estate Property Type">
                <field name="name"/>
            </search>
        </field>
    </record>

    <record id="real_estate_estate_property_type_view_form" model="ir.ui.view">
        <field name="name">estate.property.type.form</field>
        <field name="model">estate.property.type</field>
        <field name="arch" type="xml">
            <form string="Estate Property Type">
                <header>
                    <button type="action" name="%(real_estate_estate_property_offer_action)d" string="Offers" class="oe_stat_button"/>
                </header>
                <sheet>
                    <div class="oe_title ml16">
                        <h1 class="mb16">
                            <field name="name" class="mb16"/>
                        </h1>
                    </div>
                    <notebook>
                        <page string="Properties">
                            <field name="property_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="expected_price"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
<!--                        <page string="Offers">-->
<!--                            <field name="offer_ids"/>-->
<!--                        </page>-->
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="real_estate_estate_property_type_action" model="ir.actions.act_window">
        <field name="name">Estate Property Types</field>
        <field name="res_model">estate.property.type</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>