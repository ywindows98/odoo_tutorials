<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="group_real_estate_user" model="res.groups">
        <field name="name">Agent</field>
        <field name="category_id" ref="base.module_category_real_estate_brokerage"/>

        <!-- Replace the entire list of related records  -->
        <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
    </record>

    <record id="group_real_estate_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="base.module_category_real_estate_brokerage"/>

        <!-- Add the record id to the existing field, without removing existing ones  -->
        <!-- Automatically assigns manager to have and agent access also -->
        <field name="implied_ids" eval="[(4, ref('group_real_estate_user'))]"/>
    </record>


    <record id="real_estate_unrelated_user_property_rule" model="ir.rule">
        <field name="name">Unrelated agent access to properties rule</field>
        <field name="model_id" ref="model_estate_property"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="groups" eval="[Command.link(ref('group_real_estate_user'))]"/>
        <field name="domain_force">[
                '|', ('company_id', '=', False), ('company_id', 'in', company_ids)
        ]
        </field>
    </record>

    <record id="real_estate_related_user_property_rule" model="ir.rule">
        <field name="name">Related agent access to properties rule</field>
        <field name="model_id" ref="model_estate_property"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_unlink" eval="True"/>
        <field name="groups" eval="[Command.link(ref('group_real_estate_user'))]"/>
        <field name="domain_force">[
            '&amp;',
                '|', ('user_id', '=', user.id), ('user_id', '=', False),
                '|', ('company_id', '=', False), ('company_id', 'in', company_ids)
        ]
        </field>
    </record>

    <record id="real_estate_manager2_property_rule" model="ir.rule">
        <field name="name">Manager access to properties rule</field>
        <field name="model_id" ref="model_estate_property"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_unlink" eval="True"/>
        <field name="groups" eval="[Command.link(ref('group_real_estate_manager'))]"/>
    </record>

</odoo>