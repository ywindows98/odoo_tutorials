<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="awesome_owl.TodoList">
        <div>
            <input t-ref="todo_input" type="text" placeholder="Enter a new task" class="p-1 m-1 form-control mb-3" t-on-keyup="addTodo"/>
            <t t-foreach="todos" t-as="item" t-key="item.id">
                <TodoItem todo="item" toggleState.bind="toggleTodoState" removeTodo.bind="removeTodoItem"/>
            </t>
        </div>
    </t>

</templates>
